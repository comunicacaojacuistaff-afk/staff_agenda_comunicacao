# Banco: criado sozinho pela integração Neon da Vercel (DATABASE_URL)
DATABASE_URL=
# Texto longo e aleatório (assina o login). Ex.: openssl rand -hex 32
AUTH_SECRET=
# Primeiro administrador (criado automaticamente se ainda não existir admin)
ADMIN_NOME=Administrador
ADMIN_CEL=21999990000
ADMIN_SENHA=troque-esta-senha
# Chave do agendador (GitHub Actions) — a mesma nos Secrets do GitHub
CRON_SECRET=
# WhatsApp (Z-API)
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# 1 = não envia de verdade, só escreve no log da Vercel (para testar)
WHATSAPP_DRY_RUN=0
# E-mail (Brevo, plano grátis) — recuperação de senha
BREVO_API_KEY=
EMAIL_REMETENTE=
# (opcional) e-mail do primeiro administrador
ADMIN_EMAIL=
